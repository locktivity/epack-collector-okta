{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/locktivity/epack-collector-okta/docs/schema/v1.0.0.json",
  "title": "Okta Organization Security Posture",
  "description": "Security posture metrics collected from an Okta organization. A metric the collector could not read is null or absent, and the collector result artifact records why.",
  "type": "object",
  "required": ["schema_version", "collected_at", "collected_at_level", "org_domain", "posture", "users", "apps", "privileged_access", "policy", "device_access"],
  "comment": "Optional fields are gated by collected_at_level: fields marked x-epack-level audit are present at audit and internal; fields marked internal are present only at internal.",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of this schema"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when data was collected"
    },
    "collected_at_level": {
      "type": "string",
      "enum": ["trust", "audit", "internal"],
      "description": "Collection level this artifact was produced at. Levels are cumulative: audit is a superset of trust, internal of audit."
    },
    "org_domain": {
      "type": "string",
      "description": "Okta organization domain"
    },
    "posture": {
      "type": "object",
      "description": "High-level security posture scores",
      "required": ["mfa_coverage", "mfa_phishing_resistant", "sso_coverage"],
      "properties": {
        "mfa_coverage": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "/users/total_count",
          "description": "Percentage of users with any MFA factor enrolled"
        },
        "mfa_phishing_resistant": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "/users/total_count",
          "description": "Percentage of users with phishing-resistant MFA (WebAuthn/FIDO2, U2F, or Okta FastPass)"
        },
        "sso_coverage": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "/apps/total_count",
          "description": "Percentage of apps using SSO (SAML/OIDC/WS-Fed)"
        },
        "per_factor_type": {
          "type": "array",
          "x-epack-level": "audit",
          "description": "Enrolled-user count per active factor type",
          "items": {
            "type": "object",
            "properties": {
              "factor_type": {"type": "string"},
              "enrolled_users": {"type": "integer", "minimum": 0}
            }
          }
        },
        "mfa_disabled_users_count": {
          "type": "integer",
          "minimum": 0,
          "x-epack-level": "audit",
          "description": "Count of non-deprovisioned users with no active MFA"
        }
      }
    },
    "users": {
      "type": "object",
      "description": "User status metrics",
      "required": ["password_expired", "locked_out", "inactive", "suspended"],
      "properties": {
        "total_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Users other than deprovisioned ones: the population of every user percentage"
        },
        "password_expired": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "total_count",
          "description": "Percentage of users with expired passwords"
        },
        "locked_out": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "total_count",
          "description": "Percentage of users currently locked out"
        },
        "inactive": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "total_count",
          "description": "Percentage of users inactive for 90+ days"
        },
        "suspended": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "total_count",
          "description": "Percentage of users currently suspended"
        },
        "inventory": {
          "type": "array",
          "x-epack-level": "audit",
          "description": "Per-user inventory. Login is the only identifier; profile attributes beyond login are excluded. Capped at 50000 (ACTIVE-first, login-asc).",
          "items": {
            "type": "object",
            "properties": {
              "login": {"type": "string"},
              "status": {"type": "string"},
              "user_type": {"type": "string", "enum": ["Human", "Service"], "description": "Coarse classification; raw userType never emitted"},
              "created_at": {"type": "string", "format": "date-time"},
              "last_login_at": {"type": "string", "format": "date-time", "x-epack-level": "internal"},
              "last_updated_at": {"type": "string", "format": "date-time", "x-epack-level": "internal"},
              "status_changed_at": {"type": "string", "format": "date-time", "x-epack-level": "internal"},
              "password_changed_at": {"type": "string", "format": "date-time", "x-epack-level": "internal"},
              "factors": {"type": "array", "x-epack-level": "internal", "items": {"type": "object"}},
              "group_ids": {"type": "array", "x-epack-level": "internal", "items": {"type": "string"}}
            }
          }
        },
        "inventory_truncated": {"type": "boolean", "x-epack-level": "audit", "description": "True when the user inventory hit the 50000 cap"},
        "inventory_dropped": {"type": "integer", "minimum": 0, "x-epack-level": "audit", "description": "Rows dropped on truncation"}
      }
    },
    "apps": {
      "type": "object",
      "description": "Application lifecycle metrics",
      "required": ["provisioning_enabled", "deprovisioning_enabled"],
      "properties": {
        "total_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Apps: the population of every app percentage"
        },
        "provisioning_enabled": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "total_count",
          "description": "Percentage of apps with automatic user provisioning"
        },
        "deprovisioning_enabled": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "total_count",
          "description": "Percentage of apps with automatic user deprovisioning"
        },
        "inventory": {
          "type": "array",
          "x-epack-level": "audit",
          "description": "Per-app inventory (label, name, type, sign_on_mode, status, sso_configured, provisioning_configured). Capped at 5000 (ACTIVE-first, label-asc).",
          "items": {"type": "object"}
        },
        "inventory_truncated": {"type": "boolean", "x-epack-level": "audit"},
        "inventory_dropped": {"type": "integer", "minimum": 0, "x-epack-level": "audit"}
      }
    },
    "privileged_access": {
      "type": "object",
      "description": "Privileged access counts and MFA coverage",
      "required": [
        "privileged_users_count",
        "super_admin_count",
        "standing_privileged_users_count",
        "privileged_mfa_coverage_pct",
        "privileged_phishing_resistant_pct"
      ],
      "properties": {
        "privileged_users_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-rollup": {"rows": "inventory", "as": "count"},
          "description": "Count of active users with any effective Okta admin role"
        },
        "super_admin_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Count of active users with the SUPER_ADMIN role"
        },
        "standing_privileged_users_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Count of active users with standing privileged access"
        },
        "privileged_mfa_coverage_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "privileged_users_count",
          "description": "Percentage of privileged users with any MFA factor enrolled"
        },
        "privileged_phishing_resistant_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "privileged_users_count",
          "description": "Percentage of privileged users with phishing-resistant MFA"
        },
        "inventory": {
          "type": "array",
          "x-epack-level": "audit",
          "description": "Per-privileged-user login and roles.",
          "items": {
            "type": "object",
            "properties": {
              "login": {"type": "string"},
              "roles": {"type": "array", "items": {"type": "string"}},
              "role_assignment_source": {"type": "string", "enum": ["direct", "group", "mixed"], "x-epack-level": "internal"},
              "last_login_at": {"type": "string", "format": "date-time", "x-epack-level": "internal"},
              "last_admin_action_at": {"type": "string", "format": "date-time", "x-epack-level": "internal"}
            }
          }
        },
        "custom_roles": {
          "type": "array",
          "x-epack-level": "audit",
          "description": "Custom admin roles (Okta Identity Governance feature). Absent, with a not_licensed gap, when Identity Governance is not licensed.",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "label": {"type": "string"},
              "description": {"type": "string"},
              "permission_count": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "description": "Aggregated security policy settings across all active policies",
      "required": ["policy_count", "mfa_required_all", "mfa_required_any", "mfa_required_coverage_pct"],
      "properties": {
        "policy_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-rollup": {"rows": "policies", "where": "/type", "equals": "OKTA_SIGN_ON", "as": "count"},
          "description": "Number of active sign-on policies"
        },
        "mfa_required_all": {
          "type": ["boolean", "null"],
          "x-epack-denominator": "/users/total_count",
          "description": "Whether MFA is required for all non-deprovisioned users after evaluating active policies and rules"
        },
        "mfa_required_any": {
          "type": ["boolean", "null"],
          "description": "Whether MFA is required for at least one non-deprovisioned user after evaluating active policies and rules"
        },
        "mfa_required_coverage_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "/users/total_count",
          "description": "Percentage of non-deprovisioned users covered by an MFA requirement"
        },
        "session_lifetime_min_minutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-null": "No active sign-on rule sets a session lifetime",
          "description": "Shortest session lifetime across active sign-on rules (in minutes)"
        },
        "session_lifetime_max_minutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-null": "No active sign-on rule sets a session lifetime",
          "description": "Longest session lifetime across active sign-on rules (in minutes)"
        },
        "idle_timeout_min_minutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-null": "No active sign-on rule sets an idle timeout",
          "description": "Shortest idle timeout across active sign-on rules (in minutes)"
        },
        "idle_timeout_max_minutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-null": "No active sign-on rule sets an idle timeout",
          "description": "Longest idle timeout across active sign-on rules (in minutes)"
        },
        "policies": {
          "type": "array",
          "x-epack-level": "audit",
          "description": "Per-policy summary (name, type, status, priority, rule_count, scope_summary) for sign-on and MFA-enroll policies.",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string"},
              "status": {"type": "string"},
              "priority": {"type": "integer"},
              "rule_count": {"type": "integer", "minimum": 0},
              "scope_summary": {"type": "string", "enum": ["group-assigned", "everyone"]},
              "rules": {"type": "array", "x-epack-level": "internal", "description": "Rule conditions and actions", "items": {"type": "object"}}
            }
          }
        }
      }
    },
    "device_access": {
      "type": "object",
      "description": "Device access enforcement posture",
      "required": [
        "managed_device_required",
        "managed_device_required_coverage_pct",
        "managed_device_required_for_admins",
        "device_assurance_policies_count"
      ],
      "properties": {
        "managed_device_required": {
          "type": ["boolean", "null"],
          "description": "Whether any sign-on policy rule requires managed devices"
        },
        "managed_device_required_coverage_pct": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "x-epack-denominator": "/users/total_count",
          "description": "Percentage of users covered by a managed device requirement"
        },
        "managed_device_required_for_admins": {
          "type": ["boolean", "null"],
          "x-epack-denominator": "/privileged_access/privileged_users_count",
          "description": "Whether all privileged users are covered by a managed device requirement"
        },
        "device_assurance_policies_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-epack-rollup": {"rows": "policies", "as": "count"},
          "description": "Number of device assurance policies defined"
        },
        "policies": {
          "type": "array",
          "x-epack-level": "audit",
          "description": "Per-device-assurance-policy summary (name, platform, status, min_os_version, disk_encryption_required, screen_lock_required, jailbreak_protection).",
          "items": {"type": "object"}
        }
      }
    },
    "groups": {
      "type": "object",
      "x-epack-level": "audit",
      "description": "Group inventory and counts. Omitted at trust. Internal adds per-group member_logins (capped at 200000 total rows; smallest groups truncated first).",
      "properties": {
        "total_count": {"type": "integer", "minimum": 0},
        "count_by_source": {"type": "object"},
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "type": {"type": "string"},
              "source": {"type": "string"},
              "description": {"type": "string"},
              "member_count": {
                "type": ["integer", "null"],
                "minimum": 0,
                "x-epack-rollup": {"rows": "member_logins", "as": "count"},
                "description": "Okta's group statistics at audit. At internal, the members read live, so it matches member_logins; a group past the membership budget keeps the statistics."
              },
              "created_at": {"type": "string", "format": "date-time"},
              "member_logins": {"type": "array", "x-epack-level": "internal", "items": {"type": "string"}}
            }
          }
        },
        "truncated_memberships": {"type": "boolean", "x-epack-level": "internal"},
        "truncated_memberships_dropped": {"type": "integer", "x-epack-level": "internal"}
      }
    },
    "network_zones": {
      "type": "object",
      "x-epack-level": "audit",
      "description": "Network zone inventory and counts. Omitted at trust. Internal adds per-zone gateways/proxies/locations/asns.",
      "properties": {
        "total_count": {"type": "integer", "minimum": 0, "x-epack-rollup": {"rows": "inventory", "as": "count"}},
        "count_by_type": {"type": "object"},
        "gateway_zone_count": {"type": ["integer", "null"], "minimum": 0},
        "proxy_zone_count": {"type": ["integer", "null"], "minimum": 0},
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "type": {"type": "string"},
              "status": {"type": "string"},
              "usage": {"type": "string"},
              "gateways": {"type": "array", "x-epack-level": "internal", "items": {"type": "string"}},
              "proxies": {"type": "array", "x-epack-level": "internal", "items": {"type": "string"}},
              "locations": {"type": "array", "x-epack-level": "internal", "items": {"type": "string"}},
              "asns": {"type": "array", "x-epack-level": "internal", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "identity_providers": {
      "type": "object",
      "x-epack-level": "audit",
      "description": "Federation identity providers. Omitted at trust. Client secrets, signing keys, and full SSO URLs are never emitted.",
      "properties": {
        "total_count": {"type": "integer", "minimum": 0, "x-epack-rollup": {"rows": "inventory", "as": "count"}},
        "count_by_protocol": {"type": "object"},
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "type": {"type": "string"},
              "status": {"type": "string"},
              "issuer_host": {"type": "string"},
              "signing_cert_thumbprint": {"type": "string", "x-epack-level": "internal"},
              "jit_provisioning": {"type": "boolean", "x-epack-level": "internal"},
              "group_mapping_count": {"type": "integer", "minimum": 0, "x-epack-level": "internal"}
            }
          }
        }
      }
    },
    "api_tokens": {
      "type": "object",
      "x-epack-level": "audit",
      "description": "SSWS API tokens. Omitted at trust. Requires a SUPER_ADMIN-level scope; omitted with a gap and a diagnostic on 403. Token secret values are never exposed by the API.",
      "properties": {
        "total_active_count": {"type": "integer", "minimum": 0, "x-epack-rollup": {"rows": "inventory", "where": "/status", "equals": "ACTIVE", "as": "count"}},
        "recently_used_count": {"type": "integer", "minimum": 0},
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "status": {"type": "string"},
              "created_at": {"type": "string", "format": "date-time"},
              "created_by_login": {"type": "string", "x-epack-level": "internal"},
              "last_used_at": {"type": "string", "format": "date-time", "x-epack-level": "internal"},
              "network_zone_scoped": {"type": "boolean", "x-epack-level": "internal"}
            }
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "x-epack-level": "audit",
      "description": "Event and inline hooks. Omitted at trust. Hook auth headers, full URLs, and secrets are never emitted.",
      "properties": {
        "event_hook_count": {"type": ["integer", "null"], "minimum": 0, "x-epack-rollup": {"rows": "event_hooks", "as": "count"}},
        "inline_hook_count": {"type": ["integer", "null"], "minimum": 0, "x-epack-rollup": {"rows": "inline_hooks", "as": "count"}},
        "active_count": {"type": ["integer", "null"], "minimum": 0},
        "inactive_count": {"type": ["integer", "null"], "minimum": 0},
        "event_hooks": {"$ref": "#/$defs/hooks"},
        "inline_hooks": {"$ref": "#/$defs/hooks"}
      }
    },
    "system_log": {
      "type": "object",
      "x-epack-level": "audit",
      "description": "Security-relevant system-log events. Absent at trust. audit: count_by_category over the last 7 days. internal: events[] (event_type, published, actor login+type, targets[], outcome, client_ip, user_agent; no debug-context). Capped at 5000, newest first.",
      "properties": {
        "window_days": {"type": "integer"},
        "count_by_category": {"type": "object"},
        "events": {"type": "array", "x-epack-level": "internal", "items": {"type": "object"}},
        "truncated": {"type": "boolean", "x-epack-level": "internal"},
        "oldest_event_id": {"type": "string", "x-epack-level": "internal"},
        "newest_event_id": {"type": "string", "x-epack-level": "internal"}
      }
    },
    "org_settings": {
      "type": "object",
      "x-epack-level": "audit",
      "description": "Organization settings. Omitted at trust. audit: subdomain + status + self_service_recovery_enabled. internal: notification_contact_logins[].",
      "properties": {
        "subdomain": {"type": "string"},
        "status": {"type": "string"},
        "self_service_recovery_enabled": {"type": "boolean"},
        "notification_contact_logins": {"type": "array", "x-epack-level": "internal", "items": {"type": "string"}}
      }
    },
    "diagnostics": {
      "type": "object",
      "description": "Present when any surface was skipped (missing scope, feature not licensed, transient error). Carries the detail so the customer knows what to grant.",
      "properties": {
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "status": {"type": "string"},
          "subscribed_events": {"type": "array", "items": {"type": "string"}},
          "endpoint_host": {"type": "string", "x-epack-level": "internal"},
          "channel_type": {"type": "string", "x-epack-level": "internal"}
        }
      }
    }
  }
}
